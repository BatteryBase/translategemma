# TranslateGemma 配置
# 复制为 .env 后修改：cp .env.example .env
# 启动：cd ~/nhwork/translategemma/scripts && ./start_api.sh

# 服务端口（>=1024 无需 sudo；批处理推荐 8022）
PORT=8022

# GPU（4×V100 跑 27B-Q8 GGUF 多卡）
NVIDIA_VISIBLE_DEVICES=0,1,2,3

# 模型：4b / 12b / 27b
MODEL_NAME=27b

# 量化：4 或 8（GGUF）
QUANTIZATION=8

# 推理后端：gguf（推荐）/ pytorch（全精度多卡）
BACKEND=gguf

# GGUF 多卡：全部层上 GPU，四卡均分（约 28GB 总显存）
GGUF_N_GPU_LAYERS=-1
GGUF_TENSOR_SPLIT=1,1,1,1
GGUF_N_CTX=4096

# 翻译完成后保留模型在显存（秒）；0=立即卸载
GPU_IDLE_TIMEOUT=3600

# 启动预加载
MODEL_PRELOAD=true

# 长文本分块（>100 可能截断）
MAX_CHUNK_LENGTH=100

# 滑动窗口重叠（0=关闭）
DEFAULT_OVERLAP=0

# 重复惩罚（1.0=不惩罚）
REPETITION_PENALTY=1.0

# 术语表（电池/制造领域中英术语，CSV 列：source,target）
# GLOSSARY_PATH=/home/user/nhwork/translategemma/docs/glossary.csv
DEFAULT_USE_GLOSSARY=true

# HuggingFace 镜像（下载 GGUF 时用）
HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=hf_xxx

# ── 备选：4×V100 跑 27b bf16/fp16 全精度（易 CPU offload，批处理不稳定）──
# MODEL_NAME=27b
# BACKEND=pytorch
# MODEL_LOCAL_PATH=/home/user/nhwork/translategemma/models/translategemma-27b-it

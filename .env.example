# TranslateGemma 配置
# 复制为 .env 后修改：cp .env.example .env
# 启动：cd ~/nhwork/translategemma && bash scripts/start_api.sh

# 服务端口（80 需 sudo 绑定）
PORT=80

MODEL_LOCAL_PATH=/home/user/nhwork/translategemma/models/translategemma-27b-it

# GPU 选择（nvidia-smi 查看编号；多卡用逗号分隔）
NVIDIA_VISIBLE_DEVICES=0,1,2,3

# 模型：4b / 12b / 27b
# V100 16GB 单卡推荐 12b；4 卡跑 27b 全精度可改 BACKEND=pytorch 并去掉 QUANTIZATION
MODEL_NAME=27b

# 量化：4 或 8（GGUF 后端）
QUANTIZATION=4

# 推理后端：gguf（单卡推荐）/ pytorch（多卡 27b）
BACKEND=gguf

# 翻译完成后立即释放显存（0=立即卸载）
GPU_IDLE_TIMEOUT=0

# 长文本分块（>100 可能截断）
MAX_CHUNK_LENGTH=100

# 滑动窗口重叠（0=关闭）
DEFAULT_OVERLAP=0

# 重复惩罚（1.0=不惩罚）
REPETITION_PENALTY=1.0

# HuggingFace（走 ModelScope 时可忽略）
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=hf_xxx

# ModelScope 本地下载目录（scripts/download_modelscope.py 完成后填入）
# MODEL_LOCAL_PATH=/home/user/nhwork/translategemma/models/translategemma-27b-it

# ── 备选：4×V100 跑 27b 全精度（需 PyTorch 2.5.1+cu124，勿用 bitsandbytes 量化）──
# NVIDIA_VISIBLE_DEVICES=0,1,2,3
# MODEL_NAME=27b
# BACKEND=pytorch
